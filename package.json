{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "opencode-queue",
  "version": "2.0.0",
  "type": "module",
  "description": "Persistent prompt, command and shell queues for OpenCode v2",
  "main": "./index.ts",
  "keywords": [
    "opencode",
    "opencode-plugin",
    "plugin",
    "queue"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mirsella/opencode-queue.git"
  },
  "bugs": {
    "url": "https://github.com/mirsella/opencode-queue/issues"
  },
  "homepage": "https://github.com/mirsella/opencode-queue#readme",
  "license": "MIT",
  "files": [
    "index.ts",
    "tui.ts",
    "src/engine.ts",
    "src/parser.ts",
    "src/rpc.ts",
    "src/shell.ts",
    "src/storage.ts",
    "src/types.ts",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": "./index.ts",
    "./tui": "./tui.ts",
    "./rpc": "./src/rpc.ts"
  },
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public",
    "tag": "opencode2"
  },
  "scripts": {
    "test": "tsx --test src/*.test.ts",
    "typecheck": "tsc --noEmit",
    "test:docker": "bash test/docker/run.sh",
    "start:docker": "bash test/docker/tui.sh"
  },
  "dependencies": {
    "@opencode/client": "2.0.27",
    "@opencode/schema": "2.0.27"
  },
  "devDependencies": {
    "@opencode/plugin": "2.0.27",
    "effect": "4.0.1",
    "@types/node": "^24.0.0",
    "tsx": "^4.0.0",
    "typescript": "^6.0.3"
  },
  "peerDependencies": {
    "@opencode/plugin": ">=2.0.27 <3",
    "effect": "^4.0.0"
  },
  "packageManager": "pnpm@10.32.1"
}
